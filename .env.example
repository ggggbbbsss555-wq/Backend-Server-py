# ===== Ports — Railway assigns $PORT automatically, but the 3 services run
# on separate ports inside the same container. We use $PORT as the "main"
# service (candle) and pick the others with offsets. =====
PORT=8080
PORT_CANDLE=9001
PORT_TELEGRAM=9002
PORT_SIGNALS=9003

# ===== Telegram bot token (from @BotFather) =====
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ===== Node.js backend URL — for pushing webhooks back =====
# When a new signal is generated or a Telegram user sends a support message,
# we POST it to Node.js so it can broadcast to the Web App clients.
NODE_BACKEND_URL=http://localhost:8080
INTERNAL_SECRET=change-me-to-a-long-random-string

# ===== MongoDB (optional — for signal persistence) =====
# If set, signals are also persisted to MongoDB so they survive restarts.
# If not set, signals are in-memory only (lost on restart).
# Local MongoDB:    mongodb://localhost:27017
# Docker MongoDB:   mongodb://mongo:27017
MONGODB_URL=
MONGODB_DB=quantvexa

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Signals generator config =====
# How often (seconds) the signals bot generates a new signal
SIGNAL_INTERVAL_SEC=30
# Symbols pool — the bot picks a random one each tick
SIGNAL_SYMBOLS=EURUSD-OTC,GBPUSD-OTC,USDJPY-OTC,AUDUSD-OTC,USDCAD-OTC,EURJPY-OTC
# Strategies enabled at startup (comma-separated: strong,medium,pro)
SIGNAL_STRATEGIES=strong,medium,pro

# ===== Candle server config =====
# Number of candles returned by /candles/<symbol> by default
CANDLE_DEFAULT_LIMIT=200
